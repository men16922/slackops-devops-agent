# web/ 대시보드 환경변수 샘플. 복사: cp .env.local.example .env.local
# .env.local 은 .gitignore 됨 — 실 자격증명 절대 커밋 금지.

# ── 모드 A: 로컬 오프라인 (DynamoDB Local) — 기본/권장 ──
# DDB_ENDPOINT 가 설정되면 로컬 DynamoDB Local 을 사용(실 AWS 불필요, 더미 키).
DDB_ENDPOINT=http://localhost:8000
DDB_TABLE=slackops-agent
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DASHBOARD_APPROVER=web-operator

# ── 모드 B: 실 DynamoDB (Vercel/EC2) ──
# DDB_ENDPOINT 를 비우면(또는 제거) 실 DynamoDB 로 연결된다.
# Vercel 에서는 아래를 프로젝트 환경변수로 설정(읽기/쓰기 스코프 IAM 키):
#   # DDB_ENDPOINT=            (설정하지 않음)
#   DDB_TABLE=slackops-agent
#   AWS_REGION=ap-northeast-2
#   AWS_ACCESS_KEY_ID=AKIA...          # 최소 권한 IAM 사용자 키
#   AWS_SECRET_ACCESS_KEY=...
#   DASHBOARD_APPROVER=<승인자 표시명>
# 자세한 IAM 최소 권한·키 발급 절차는 루트 USER_GUIDE.md 참조.
