# GitHub OAuth (required whenever DDB_ENDPOINT is not a local DynamoDB endpoint)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
# Comma-separated GitHub logins; empty is fail-closed.
GITHUB_ALLOWED_USERS=

# Local offline demo only. Docker Compose sets this with its local DDB endpoint.
# Never set this in Vercel or any non-local environment.
# AUTH_BYPASS_FOR_LOCAL_DEVELOPMENT=true
