{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BootstrapSecretRead",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter"
      ],
      "Resource": [
        "arn:aws:ssm::__ACCOUNT_ID__:parameter/slackops/SLACK_BOT_TOKEN",
        "arn:aws:ssm::__ACCOUNT_ID__:parameter/slackops/SLACK_APP_TOKEN",
        "arn:aws:ssm::__ACCOUNT_ID__:parameter/slackops/CLAUDE_CODE_OAUTH_TOKEN",
        "arn:aws:ssm::__ACCOUNT_ID__:parameter/slackops/SLACK_NOTIFY_CHANNEL",
        "arn:aws:ssm::__ACCOUNT_ID__:parameter/slackops/SLACK_APPROVER_IDS",
        "arn:aws:ssm::__ACCOUNT_ID__:parameter/slackops/DASHBOARD_URL"
      ]
    },
    {
      "Sid": "AssumeOnlySlackOpsRuntimeRoles",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole"
      ],
      "Resource": [
        "arn:aws:iam::__ACCOUNT_ID__:role/slackops-devops-agent-runtime-role",
        "arn:aws:iam::__ACCOUNT_ID__:role/slackops-devops-agent-mcp-role"
      ]
    }
  ]
}
