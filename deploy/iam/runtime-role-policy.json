{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenySecurityBoundaryAuditWrite",
      "Effect": "Deny",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:PutRetentionPolicy"
      ],
      "Resource": [
        "arn:aws:logs:__REGION__:__ACCOUNT_ID__:log-group:/slackops/security-boundary-audit",
        "arn:aws:logs:__REGION__:__ACCOUNT_ID__:log-group:/slackops/security-boundary-audit:*"
      ]
    },
    {
      "Sid": "CloudWatchReadOnly",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LogsReadOnly",
      "Effect": "Allow",
      "Action": [
        "logs:Describe*",
        "logs:Get*",
        "logs:List*",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:StopQuery"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EksDescribeOnly",
      "Effect": "Allow",
      "Action": [
        "eks:Describe*",
        "eks:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GovernanceDetectionsReadOnly",
      "Effect": "Allow",
      "Action": [
        "access-analyzer:List*",
        "access-analyzer:Get*",
        "config:Describe*",
        "config:Get*",
        "config:List*",
        "ssm:DescribeInstancePatchStates",
        "ssm:DescribeInstanceInformation",
        "ssm:ListComplianceItems",
        "ssm:ListResourceComplianceSummaries"
      ],
      "Resource": "*"
    },
    {
      "Sid": "OtelExport",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData",
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "xray:PutTraceSegments",
        "xray:PutTelemetryRecords"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DynamoDbControlPlane",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:__REGION__:__ACCOUNT_ID__:table/slackops-agent",
        "arn:aws:dynamodb:__REGION__:__ACCOUNT_ID__:table/slackops-agent/index/*"
      ]
    }
  ]
}
