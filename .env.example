# slackops-devops-agent — 환경 변수 예시 (.env 는 절대 커밋 금지)
# 실제 자격증명은 IAM Instance Profile 사용 — Access Key 저장/커밋 절대 금지.

# --- Slack (Socket Mode) ---
SLACK_BOT_TOKEN=xoxb-...          # Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...          # App-Level Token (Socket Mode, connections:write)
SLACK_SIGNING_SECRET=...          # Signing Secret

# --- AWS ---
AWS_REGION=ap-northeast-2
# 자격증명은 EC2 Instance Profile 로 주입 — 여기에 키 넣지 말 것.

# --- GitHub App (최소 스코프) ---
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=      # 파일 경로(키 본문 커밋 금지)

# --- Job queue (SQLite, MVP 한정) ---
JOB_QUEUE_DB_PATH=./jobs.db

# --- Observability (OTel → ADOT Collector) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=slackops-devops-agent

# --- Claude Code Headless ---
CLAUDE_CODE_TIMEOUT_S=300
